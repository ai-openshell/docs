---
// SPDX-License-Identifier: Apache-2.0
// Header: the site bar (wordmark, site links, search, GitHub, theme), then
// topic tabs, then (in topics with an overview page) sub-tabs for the overview
// and each docset. The site bar matches the landing page header (www/index.html);
// both take their links from theme/nav.json.
// Tab and sub-tab links come from src/routeData.ts and follow the current
// page's version context.
import { Icon } from '@astrojs/starlight/components';
import Search from '@astrojs/starlight/components/Search.astro';
import siteNav from '../../../../theme/nav.json';

const os = Astro.locals.osVersion;
const topics = os?.topics ?? [];
const ds = os?.docsets;
const subtabs = ds
  ? [
      ...(ds.topic.landing ? [{ label: 'Overview', href: ds.topic.landing, current: ds.topic.isLanding }] : []),
      ...ds.items.map((d) => ({
        label: d.title,
        href: d.href,
        current: d.current,
      })),
    ]
  : [];
---

<div class="os-header">
  <div class="os-header__row">
    <a href={import.meta.env.BASE_URL} class="os-wordmark" translate="no">
      <!-- The OpenShell shield (ai-openshell/openshell docs/brand/assets/openshell-mark.svg), cropped to the shield -->
      <svg viewBox="14 7 72 87" aria-hidden="true" class="os-wordmark__mark"><path d="M50 9 L84 23 V51 C84 72 69 86 50 92 C31 86 16 72 16 51 V23 Z" fill="#76B900"/><g fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"><path d="M37 41 L49 50 L37 59"/><path d="M55 59 H67"/></g></svg>
      <span>OpenShell</span>
    </a>
    <nav class="os-site-links print:hidden" aria-label="Site">
      {siteNav.links.map((l) => (
        <a href={l.href} class="os-site-link" aria-current={l.href === import.meta.env.BASE_URL ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="os-header__search print:hidden"><Search /></div>
    <div class="os-header__end print:hidden sl-hidden md:sl-flex">
      <a href={siteNav.github} class="os-icon-button"><span class="sr-only">GitHub</span><Icon name="github" /></a>
      <button type="button" class="os-icon-button os-theme-toggle" aria-label="Toggle dark mode">
        <Icon name="sun" class="os-theme-toggle__sun" />
        <Icon name="moon" class="os-theme-toggle__moon" />
      </button>
    </div>
  </div>
  <nav class="os-tabs print:hidden" aria-label="Topics">
    {topics.map((t) => (
      <a href={t.href} class="os-tab" aria-current={t.isCurrent ? 'true' : undefined}>{t.label}</a>
    ))}
  </nav>
  {ds?.topic.landing && (
    <div class="os-subtabs print:hidden">
      <nav class="os-subtabs__links" aria-label={ds.topic.label}>
        {subtabs.map((t) => (
          <a href={t.href} class="os-subtab" aria-current={t.current ? 'true' : undefined}>{t.label}</a>
        ))}
      </nav>
      <!-- Narrow screens: the same choices as a dropdown -->
      <details class="os-subtabs__menu">
        <summary>
          <span class="os-subtabs__current">{subtabs.find((t) => t.current)?.label ?? 'Overview'}</span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </summary>
        <ul>
          {subtabs.map((t) => (
            <li>
              <a href={t.href} aria-current={t.current ? 'true' : undefined}>{t.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  )}
</div>

<script>
  // Same behavior as the landing page toggle. Starlight keeps the choice in
  // localStorage (starlight-theme); the mobile menu's theme select follows it.
  document.querySelector('.os-theme-toggle')?.addEventListener('click', () => {
    const t = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = t;
    try {
      localStorage.setItem('starlight-theme', t);
    } catch {}
    (window as { StarlightThemeProvider?: { updatePickers(t: string): void } }).StarlightThemeProvider?.updatePickers(t);
  });
  document.addEventListener('click', (e) => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>('details.os-subtabs__menu[open]'))
      if (!d.contains(e.target as Node)) d.open = false;
  });
</script>
